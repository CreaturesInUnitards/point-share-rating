# osyd packages are published to GitHub Packages under the @creatureshoppe scope.
#
# Auth is intentionally NOT in this file: pnpm/npm will not expand secrets from a
# committed project .npmrc. Put your GitHub token (needs read:packages) in your
# UNTRACKED user-level ~/.npmrc instead, e.g.:
#
#   //npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
#
# or store the literal token with:
#
#   npm config set "//npm.pkg.github.com/:_authToken" <token>
@creatureshoppe:registry=https://npm.pkg.github.com
